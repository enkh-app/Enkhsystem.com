{
  "expo": {
    "name": "enkh-app",
    "slug": "nasaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "enkhapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/enkh-ios-icon.png",
      "bundleIdentifier": "com.enkhsystem.enkh",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "ENKH AI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ENKH AI-д асуултаа дуугаар хэлэхийн тулд микрофон ашиглахыг зөвшөөрнө үү.",
          "speechRecognitionPermission": "ENKH AI-д таны хэлсэн асуултыг бичвэр болгохыг зөвшөөрнө үү."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "sitemap": false
      },
      "eas": {
        "projectId": "0a058132-e8ad-43f8-9be0-cf27937541f8"
      }
    },
    "owner": "enkhsystems-team"
  }
}
