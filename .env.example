# Optional development override. Never put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_ENKH_API_URL=http://localhost:3000

# Native Auth0 public configuration. Leave unset until the Mobile application and callback are registered.
# These are public identifiers, never client secrets or bearer/refresh tokens.
EXPO_PUBLIC_AUTH0_ISSUER_BASE_URL=
EXPO_PUBLIC_AUTH0_MOBILE_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
